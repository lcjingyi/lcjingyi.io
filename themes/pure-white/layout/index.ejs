<section class="post-list">
  <% page.posts.each(function(post) { %>
    <article class="post-item">
      <h2 class="post-title">
        <a href="<%= url_for(post.path) %>"><%= post.title %></a>
      </h2>
      <div class="post-meta">
        <time><%= date(post.date, 'YYYY-MM-DD') %></time>
        <% if (post.tags && post.tags.length) { %>
          <span class="dot">·</span>
          <% post.tags.each(function(tag) { %>
            <a class="tag" href="<%= url_for(tag.path) %>"><%= tag.name %></a>
          <% }); %>
        <% } %>
      </div>
      <% if (theme.index.excerpt && post.excerpt) { %>
        <div class="post-excerpt"><%= post.excerpt %></div>
      <% } else if (theme.index.excerpt) { %>
        <div class="post-excerpt"><%= post.content.substring(0, theme.index.excerpt_length) %></div>
      <% } %>
    </article>
  <% }); %>
</section>

<%- partial('_partial/pagination') %>
