<% if (page.total > 1) { %>
<nav class="pagination">
  <% if (page.prev) { %>
    <a href="<%= url_for(page.prev_link) %>" class="page-prev">← Previous</a>
  <% } %>
  <span class="page-info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a href="<%= url_for(page.next_link) %>" class="page-next">Next →</a>
  <% } %>
</nav>
<% } %>
